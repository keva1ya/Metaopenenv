# ═══════════════════════════════════════════════════════════════
# Metaopenenv — environment template
# Copy to .env locally, or set these as Hugging Face Space
# Variables / Secrets in production.
# ═══════════════════════════════════════════════════════════════

# ── Aggregator-only mode switches ──────────────────────────────
# Production MUST keep both of these false.
DYNAMIC_WEIGHT_USE_NEURAL=false
GRPO_TRAIN_ENABLED=false

# ── RL trace collection (offline RL pipeline) ──────────────────
RL_TRACE_ENABLED=true
RL_TRACE_PATH=logs/rl_trace.jsonl
RL_TRACE_FLUSH_EVERY=32
RL_TRACE_MAX_BUFFER=2048

# ── Reward shaping ─────────────────────────────────────────────
REWARD_FLOOR=0.0
UNCERTAINTY_PENALTY_ENABLED=false
UNCERTAINTY_PENALTY_WEIGHT=0.0

# ═══════════════════════════════════════════════════════════════
# Head LLM endpoints (Hugging Face Inference Endpoints)
#   RiskAgent   → Qwen 2.5
#   PolicyAgent → Mistral 7B
#   FraudAgent  → Llama 3
# ═══════════════════════════════════════════════════════════════

# Shared HF read token — used when *_API_KEY is unset.
HF_TOKEN=

# ── Risk Agent (Qwen) ──────────────────────────────────────────
RISK_MODEL=
RISK_API_KEY=
RISK_API_BASE=

# ── Policy Agent (Mistral) ─────────────────────────────────────
POLICY_MODEL=
POLICY_API_KEY=
POLICY_API_BASE=

# ── Fraud Agent (Llama 3) ──────────────────────────────────────
FRAUD_MODEL=
FRAUD_API_KEY=
FRAUD_API_BASE=

# ═══════════════════════════════════════════════════════════════
# API & UI Authentication
# ═══════════════════════════════════════════════════════════════

# FastAPI X-API-Key for /reset, /step, /state. /health is open.
APP_API_KEY=

# Basic auth gate for the Gradio UI.
APP_UI_USERNAME=
APP_UI_PASSWORD=

# Optional ports (defaults shown).
APP_API_PORT=8000
APP_UI_PORT=7860

# ═══════════════════════════════════════════════════════════════
# Offline RL log sync (used by scripts/sync_logs_to_hf_dataset.py)
# ═══════════════════════════════════════════════════════════════
HF_TRACE_DATASET_REPO=
HF_TRACE_SYNC_INTERVAL_SEC=3600

# ═══════════════════════════════════════════════════════════════
# Legacy OpenRouter fallbacks (only used when HF_* are absent)
# Leave blank in production.
# ═══════════════════════════════════════════════════════════════
NEMOTRON_API_KEY=
GLM_API_KEY=
MINIMAX_API_KEY=
